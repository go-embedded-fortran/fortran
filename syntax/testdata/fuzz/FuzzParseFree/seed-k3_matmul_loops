[]byte("! K3 of bib/fortran.md 4.2: matmul as a triple loop, loop order j,k,i, 512 x 512.\n! Line 1: checksum. Line 2: \"time <seconds>\" (cpu_time around the loops).\nprogram k3loops\n  implicit none\n  integer, parameter :: n = 512\n  real(8), allocatable :: a(:,:), b(:,:), c(:,:)\n  real(8) :: t0, t1\n  integer :: i, j, k\n  allocate (a(n,n), b(n,n), c(n,n))\n  do j = 1, n\n    do i = 1, n\n      a(i,j) = real(mod(i + 2*j, 7), 8)/7d0\n      b(i,j) = real(mod(3*i + j, 5), 8)/5d0\n    end do\n  end do\n  c = 0d0\n  call cpu_time(t0)\n  do j = 1, n\n    do k = 1, n\n      do i = 1, n\n        c(i,j) = c(i,j) + a(i,k)*b(k,j)\n      end do\n    end do\n  end do\n  call cpu_time(t1)\n  print '(es24.16)', sum(c)\n  print '(a,f0.6)', 'time ', t1 - t0\nend program k3loops\n")
