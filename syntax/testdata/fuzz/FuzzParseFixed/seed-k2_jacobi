[]byte("! K2 of bib/fortran.md 4.2: 2-D five-point Jacobi stencil, column-major order\n! (j outer, i inner), 100 sweeps, 1024 x 1024. Inputs from a fixed formula.\n! Line 1: checksum. Line 2: \"time <seconds>\" (cpu_time around the sweeps).\nprogram k2\n  implicit none\n  integer, parameter :: n = 1024, sweeps = 100\n  real(8), allocatable :: u(:,:), v(:,:)\n  real(8) :: t0, t1\n  integer :: i, j, s\n  allocate (u(n,n), v(n,n))\n  do j = 1, n\n    do i = 1, n\n      u(i,j) = real(mod(i*7 + j*13, 17), 8)/17d0\n    end do\n  end do\n  v = u\n  call cpu_time(t0)\n  do s = 1, sweeps\n    do j = 2, n - 1\n      do i = 2, n - 1\n        v(i,j) = 0.25d0*(u(i-1,j) + u(i+1,j) + u(i,j-1) + u(i,j+1))\n      end do\n    end do\n    do j = 2, n - 1\n      do i = 2, n - 1\n        u(i,j) = v(i,j)\n      end do\n    end do\n  end do\n  call cpu_time(t1)\n  print '(es24.16)', sum(u)\n  print '(a,f0.6)', 'time ', t1 - t0\nend program k2\n")
