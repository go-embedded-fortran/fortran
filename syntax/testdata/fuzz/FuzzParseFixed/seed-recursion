[]byte("program recursion\n  implicit none\n  integer :: i\n  print *, factorial(10)\n  print *, (fib(i), i = 0, 15)\n  print *, ackermann(2, 3)\n  call countdown(3)\n  print *, gcd(1071, 462)\n  print *, depth(5000)\ncontains\n  recursive function factorial(n) result(r)\n    integer, intent(in) :: n\n    integer(8) :: r\n    if (n <= 1) then\n      r = 1\n    else\n      r = n * factorial(n - 1)\n    end if\n  end function factorial\n  recursive function fib(n) result(r)\n    integer, intent(in) :: n\n    integer :: r\n    if (n < 2) then\n      r = n\n    else\n      r = fib(n - 1) + fib(n - 2)\n    end if\n  end function fib\n  recursive function ackermann(m, n) result(r)\n    integer, intent(in) :: m, n\n    integer :: r\n    if (m == 0) then\n      r = n + 1\n    else if (n == 0) then\n      r = ackermann(m - 1, 1)\n    else\n      r = ackermann(m - 1, ackermann(m, n - 1))\n    end if\n  end function ackermann\n  recursive subroutine countdown(n)\n    integer, intent(in) :: n\n    print *, 'n =', n\n    if (n > 0) call countdown(n - 1)\n  end subroutine countdown\n  recursive integer function gcd(a, b) result(g)\n    integer, intent(in) :: a, b\n    if (b == 0) then\n      g = a\n    else\n      g = gcd(b, mod(a, b))\n    end if\n  end function gcd\n  recursive integer function depth(n) result(d)\n    integer, intent(in) :: n\n    if (n == 0) then\n      d = 0\n    else\n      d = 1 + depth(n - 1)\n    end if\n  end function depth\nend program recursion\n")
